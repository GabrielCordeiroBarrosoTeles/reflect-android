{
  "name": "reflect-android",
  "displayName": "Reflect — Android & iOS Simulator",
  "description": "Mirror and control Android devices and iOS Simulators inside VS Code. Built for React Native developers.",
  "version": "0.2.0",
  "publisher": "GabrielCordeiro",
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#2d5bff",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielCordeiroBarrosoTeles/reflect-android.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielCordeiroBarrosoTeles/reflect-android/issues"
  },
  "homepage": "https://github.com/GabrielCordeiroBarrosoTeles/reflect-android#readme",
  "qna": "https://github.com/GabrielCordeiroBarrosoTeles/reflect-android/discussions",
  "sponsor": {
    "url": "https://github.com/sponsors/GabrielCordeiroBarrosoTeles"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "android",
    "react native",
    "react-native",
    "expo",
    "flutter",
    "scrcpy",
    "adb",
    "mirror",
    "screen mirroring",
    "screen mirror",
    "physical device",
    "real device",
    "android emulator",
    "emulator alternative",
    "device",
    "mobile",
    "usb",
    "wifi debugging",
    "inspector",
    "react devtools",
    "component inspector",
    "screenshot",
    "screen recording",
    "device info",
    "debugging",
    "mobile development",
    "android debugging",
    "asyncstorage",
    "hot reload",
    "metro",
    "ios",
    "ios simulator",
    "xcode",
    "simulator"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "reflect.openDevice",
        "title": "Open Device",
        "category": "Reflect",
        "icon": "$(device-mobile)"
      },
      {
        "command": "reflect.openDeviceInEditor",
        "title": "Open Device in Editor Tab",
        "category": "Reflect",
        "icon": "$(link-external)"
      },
      {
        "command": "reflect.refreshDeviceInfo",
        "title": "Refresh Device Info",
        "category": "Reflect",
        "icon": "$(refresh)"
      },
      {
        "command": "reflect.copyValue",
        "title": "Copy Value",
        "category": "Reflect"
      },
      {
        "command": "reflect.inspect",
        "title": "Inspect Component",
        "category": "Reflect",
        "icon": "$(inspect)"
      },
      {
        "command": "reflect.stopInspecting",
        "title": "Stop Inspecting",
        "category": "Reflect",
        "icon": "$(close)"
      },
      {
        "command": "reflect.openComponentSource",
        "title": "Open Component Source",
        "category": "Reflect"
      },
      {
        "command": "reflect.action.back",
        "title": "Back",
        "category": "Reflect",
        "icon": "$(arrow-left)"
      },
      {
        "command": "reflect.action.home",
        "title": "Home",
        "category": "Reflect",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "reflect.action.recents",
        "title": "Recent Apps",
        "category": "Reflect",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "reflect.action.rotate",
        "title": "Rotate",
        "category": "Reflect",
        "icon": "$(sync)"
      },
      {
        "command": "reflect.action.screenPower",
        "title": "Turn Device Screen On/Off",
        "category": "Reflect",
        "icon": "$(eye-closed)"
      },
      {
        "command": "reflect.action.screenshot",
        "title": "Take Screenshot",
        "category": "Reflect",
        "icon": "$(device-camera)"
      },
      {
        "command": "reflect.action.record",
        "title": "Start/Stop Recording",
        "category": "Reflect",
        "icon": "$(record)"
      },
      {
        "command": "reflect.action.devMenu",
        "title": "Open React Native Dev Menu",
        "category": "Reflect",
        "icon": "$(menu)"
      },
      {
        "command": "reflect.action.reload",
        "title": "Reload React Native App",
        "category": "Reflect",
        "icon": "$(refresh)"
      },
      {
        "command": "reflect.action.reverseMetro",
        "title": "Reverse Metro Port (adb reverse)",
        "category": "Reflect",
        "icon": "$(plug)"
      },
      {
        "command": "reflect.moveToEditor",
        "title": "Move to Editor Tab",
        "category": "Reflect",
        "icon": "$(link-external)"
      },
      {
        "command": "reflect.moveToSidebar",
        "title": "Move to Side Bar",
        "category": "Reflect",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "reflect.refreshStorage",
        "title": "Refresh AsyncStorage",
        "category": "Reflect",
        "icon": "$(refresh)"
      },
      {
        "command": "reflect.copyStorageJson",
        "title": "Copy AsyncStorage as JSON",
        "category": "Reflect",
        "icon": "$(json)"
      },
      {
        "command": "reflect.addStorageKey",
        "title": "Add AsyncStorage Key",
        "category": "Reflect",
        "icon": "$(add)"
      },
      {
        "command": "reflect.clearStorage",
        "title": "Delete All AsyncStorage Keys",
        "category": "Reflect",
        "icon": "$(clear-all)"
      },
      {
        "command": "reflect.bootSimulator",
        "title": "Boot iOS Simulator",
        "category": "Reflect",
        "icon": "$(play)"
      },
      {
        "command": "reflect.showInSimulator",
        "title": "Show in Simulator",
        "category": "Reflect",
        "icon": "$(link-external)"
      }
    ],
    "configuration": {
      "title": "Reflect — Android & iOS Simulator",
      "properties": {
        "reflect.adbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `adb` executable. Leave empty to auto-detect."
        },
        "reflect.location": {
          "type": "string",
          "enum": [
            "secondarySidebar",
            "editor"
          ],
          "enumDescriptions": [
            "Show the device in the Secondary Side Bar.",
            "Show the device in an editor tab."
          ],
          "default": "secondarySidebar",
          "markdownDescription": "Where **Reflect: Open Device** shows the mirrored screen."
        },
        "reflect.metroPort": {
          "type": "number",
          "default": 8081,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port of the Metro bundler used to inspect React Native components."
        },
        "reflect.inspector.openSourceOnSelect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open the source file of an inspected component automatically."
        },
        "reflect.privacy.maskIpAddress": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Hide the last part of the device IP address in **Device Info** (useful for screenshots and recordings)."
        },
        "reflect.capturesDirectory": {
          "type": "string",
          "default": "reflect-captures",
          "markdownDescription": "Folder for screenshots and recordings. Relative paths are resolved against the first workspace folder; without a workspace they go to `~/Pictures/Reflect`."
        },
        "reflect.copyCapturesToClipboard": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Copy screenshots (as images) and recordings (as files) to the system clipboard so you can paste them anywhere."
        },
        "reflect.ios.simulatorWindow": {
          "type": "string",
          "enum": [
            "hide",
            "quit",
            "leave"
          ],
          "enumDescriptions": [
            "Hide the Simulator app (all its windows) while a simulator is mirrored in Reflect.",
            "Quit the Simulator app. Booted simulators stay booted.",
            "Leave the Simulator app as it is."
          ],
          "default": "hide",
          "markdownDescription": "What to do with the Simulator app window when a simulator is brought into Reflect."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "reflect",
          "title": "Reflect",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "reflect": [
        {
          "type": "webview",
          "id": "reflect.deviceView",
          "name": "Device"
        },
        {
          "type": "webview",
          "id": "reflect.tools",
          "name": "Tools"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "reflect.inspect",
          "when": "view == reflect.deviceView && !reflect.inspecting",
          "group": "navigation@0"
        },
        {
          "command": "reflect.stopInspecting",
          "when": "view == reflect.deviceView && reflect.inspecting",
          "group": "navigation@0"
        },
        {
          "command": "reflect.openDevice",
          "when": "view == reflect.deviceView",
          "group": "navigation@1"
        },
        {
          "command": "reflect.moveToEditor",
          "when": "view == reflect.deviceView",
          "group": "navigation@2"
        },
        {
          "command": "reflect.refreshDeviceInfo",
          "when": "view == reflect.tools && reflect.toolsTab == device",
          "group": "navigation@1"
        },
        {
          "command": "reflect.addStorageKey",
          "when": "view == reflect.tools && reflect.toolsTab == storage",
          "group": "navigation@0"
        },
        {
          "command": "reflect.copyStorageJson",
          "when": "view == reflect.tools && reflect.toolsTab == storage",
          "group": "navigation@1"
        },
        {
          "command": "reflect.refreshStorage",
          "when": "view == reflect.tools && reflect.toolsTab == storage",
          "group": "navigation@2"
        },
        {
          "command": "reflect.clearStorage",
          "when": "view == reflect.tools && reflect.toolsTab == storage",
          "group": "9_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reflect.copyValue",
          "when": "false"
        },
        {
          "command": "reflect.openComponentSource",
          "when": "false"
        },
        {
          "command": "reflect.stopInspecting",
          "when": "reflect.inspecting"
        },
        {
          "command": "reflect.refreshStorage",
          "when": "reflect.appConnected"
        },
        {
          "command": "reflect.copyStorageJson",
          "when": "reflect.appConnected"
        },
        {
          "command": "reflect.addStorageKey",
          "when": "reflect.appConnected"
        },
        {
          "command": "reflect.clearStorage",
          "when": "reflect.appConnected"
        },
        {
          "command": "reflect.bootSimulator",
          "when": "isMac"
        },
        {
          "command": "reflect.showInSimulator",
          "when": "isMac"
        }
      ],
      "editor/title": [
        {
          "command": "reflect.moveToSidebar",
          "when": "activeWebviewPanelId == 'reflect.mirror'",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "reflect.action.back",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      },
      {
        "command": "reflect.action.home",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      },
      {
        "command": "reflect.action.reload",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      },
      {
        "command": "reflect.action.devMenu",
        "key": "ctrl+m",
        "mac": "cmd+m",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      },
      {
        "command": "reflect.action.screenshot",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      },
      {
        "command": "reflect.action.rotate",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "activeWebviewPanelId == 'reflect.mirror' || focusedView == 'reflect.deviceView'"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "fetch-server": "node scripts/fetch-server.mjs",
    "build:ios-helper": "node scripts/build-ios-helper.mjs",
    "vscode:prepublish": "npm run typecheck && npm test && node esbuild.mjs --production",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "mediabunny": "1.61.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.106.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "4.0.0",
    "@yume-chan/fetch-scrcpy-server": "1.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "ovsx": "1.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
